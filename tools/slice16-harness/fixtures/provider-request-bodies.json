            "type": "function",
            "function": {
              "name": "dla_feasibility",
              "description": "Return DLA and launch-site screening verdicts for one Lambert cell. Unknown bodies return not_found; departure dates outside the committed Earth ephemeris span return out_of_envelope.",
              "parameters": {
                "type": "object",
                "properties": {
                  "designation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "departureDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "tofDays": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "M": {
                    "type": "number",
                    "enum": [
                      0,
                      1,
                      2
                    ],
                    "default": 0
                  },
                  "siteId": {
                    "type": "string",
                    "enum": [
                      "cape-canaveral",
                      "vandenberg-sfb"
                    ]
                  }
                },
                "required": [
                  "designation",
                  "departureDate",
                  "tofDays"
                ],
                "additionalProperties": false,
                "$schema": "http://json-schema.org/draft-07/schema#"
              }
            }
          },
          {
            "type": "function",
            "function": {
              "name": "estimate_mission_cost",
              "description": "Return the Slice 13 delivered-mass screening chain for one Lambert cell and vehicle. Unknown bodies return not_found; choosing a vehicle outside its published C3 curve returns out_of_envelope instead of extrapolating.",
              "parameters": {
                "type": "object",
                "properties": {
                  "designation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "departureDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "tofDays": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "M": {
                    "type": "number",
                    "enum": [
                      0,
                      1,
                      2
                    ],
                    "default": 0
                  },
                  "vehicleId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "siteId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "designation",
                  "departureDate",
                  "tofDays",
                  "vehicleId"
                ],
                "additionalProperties": false,
                "$schema": "http://json-schema.org/draft-07/schema#"
              }
            }
          },
          {
            "type": "function",
            "function": {
              "name": "explain_cell",
              "description": "Return the ordered derivation trail for one departure/TOF cell. Unknown bodies return not_found; selecting a vehicle outside its published C3 curve returns out_of_envelope instead of extrapolating.",
              "parameters": {
                "type": "object",
                "properties": {
                  "designation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "departureDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "tofDays": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "M": {
                    "type": "number",
                    "enum": [
                      0,
                      1,
                      2
                    ],
                    "default": 0
                  },
                  "vehicleId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "siteId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "designation",
                  "departureDate",
                  "tofDays"
                ],
                "additionalProperties": false,
                "$schema": "http://json-schema.org/draft-07/schema#"
              }
            }
          },
          {
            "type": "function",
            "function": {
              "name": "get_body",
              "description": "Return one full Slice 9 catalog body record with Lambert screening status and quantity leaves. Unknown bodies return not_found.",
              "parameters": {
                "type": "object",
                "properties": {
                  "designation": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "designation"
                ],
                "additionalProperties": false,
                "$schema": "http://json-schema.org/draft-07/schema#"
              }
            }
          },
          {
            "type": "function",
            "function": {
              "name": "get_validation_report",
              "description": "Read the committed solver-validation artifacts without recomputing them. Figures are class-labeled so M=0, multi-rev magnitude-only, DLA vectors, and cost STRICT/OBSERVED surfaces cannot be conflated.",
              "parameters": {
                "type": "object",
                "properties": {
                  "section": {
                    "type": "string",
                    "enum": [
                      "lambert_m0",
                      "lambert_multirev",
                      "dla_vectors",
                      "cost_oracle",
                      "all"
                    ],
                    "default": "all"
                  }
                },
                "additionalProperties": false,
                "$schema": "http://json-schema.org/draft-07/schema#"
              }
            }
          },
          {
            "type": "function",
            "function": {
              "name": "porkchop_scan",
              "description": "Run a bounded Lambert grid and return the lowest-C3 feasible cells. Unknown bodies return not_found; departure dates outside the committed Earth ephemeris span return out_of_envelope.",
              "parameters": {
                "type": "object",
                "properties": {
                  "designation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "departureStart": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "departureEnd": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "tofMinDays": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "tofMaxDays": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "M": {
                    "type": "number",
                    "enum": [
                      0,
                      1,
                      2
                    ],
                    "default": 0
                  },
                  "gridDeparture": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "default": 80
                  },
                  "gridTof": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "default": 50
                  },
                  "topN": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "default": 10
                  }
                },
                "required": [
                  "designation",
                  "departureStart",
                  "departureEnd",
                  "tofMinDays",
                  "tofMaxDays"
                ],
                "additionalProperties": false,
                "$schema": "http://json-schema.org/draft-07/schema#"
              }
            }
          },
          {
            "type": "function",
            "function": {
              "name": "search_bodies",
              "description": "Search the closed-world Slice 9 NEA catalog by designation, name, orbit class, and Lambert screening status.",
              "parameters": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1
                  },
                  "orbitClass": {
                    "type": "string",
                    "minLength": 1
                  },
                  "screeningStatus": {
                    "type": "string",
                    "enum": [
                      "low_departure_c3",
                      "high_departure_c3",
                      "lambert_unconvergeable",
                      "propagator_failed"
                    ]
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200,
                    "default": 50
                  },
                  "cursor": {
                    "type": "string",
                    "pattern": "^\\d+$"
                  }
                },
                "additionalProperties": false,
                "$schema": "http://json-schema.org/draft-07/schema#"
              }
            }
          }
        ]
      }
    }
  }
