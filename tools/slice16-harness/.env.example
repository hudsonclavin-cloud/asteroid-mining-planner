# Slice 16 agent-honesty study — environment template.
# MARKER: S16-LOCK-AND-HARNESS-2026-07-27-A
#
# Copy to `.env` and fill in. NEVER commit the filled copy — the root .gitignore
# ignores `.env` and `.env.*`; only THIS template is exempted.
#
# The harness does not read .env automatically (no dotenv dependency). Load it
# yourself for the command you are running, e.g.:
#
#   set -a; source tools/slice16-harness/.env; set +a
#
# Nothing here is set by an agent. Both the flag and the keys are Hudson's act.

# ---------------------------------------------------------------------------
# SPEND GATE — the harness refuses every live call unless this is exactly "1".
# Leave it unset (or absent) whenever you are not deliberately spending money.
# ---------------------------------------------------------------------------
S16_LIVE_OK=

# ---------------------------------------------------------------------------
# Provider keys. A model is only runnable when its key is present AND
# S16_LIVE_OK=1. Missing keys cause that model to be skipped with disclosure,
# not silently substituted.
# ---------------------------------------------------------------------------

# platform.openai.com  -> gpt-5.5, gpt-5.5-mini
OPENAI_API_KEY=

# console.anthropic.com -> claude-sonnet-4-6, claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# Google AI Studio (aistudio.google.com) -> gemini-3.1-pro
GOOGLE_API_KEY=

# platform.together.ai -> the open-weight slot (A6: replaces DeepSeek, US jurisdiction)
# NOTE: the roster's Together model string is a PENDING SENTINEL. Fill it in
# tools/slice16-harness/config.mjs from Together's live model list before the
# pilot, and confirm that model's endpoint actually supports tool calling.
TOGETHER_API_KEY=
