{
  "name": "aster-mission-mcp",
  "version": "0.1.0",
  "description": "Evidence-carrying MCP server for validated asteroid mission planning.",
  "private": true,
  "type": "module",
  "main": "dist/mcp/src/index.js",
  "bin": {
    "aster-mission-mcp": "dist/mcp/src/index.js"
  },
  "files": [
    "dist/mcp/src",
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hudsonclavin-cloud/asteroid-mining-planner.git",
    "directory": "mcp"
  },
  "keywords": [
    "asteroids",
    "astrodynamics",
    "lambert",
    "mcp",
    "mission-planning"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p .",
    "eval": "tsc --target ES2022 --lib ES2022 --module NodeNext --moduleResolution NodeNext --esModuleInterop --skipLibCheck --strict --rootDir . --outDir dist eval/run-eval.ts && node dist/eval/run-eval.js",
    "test": "npm run build && node --test dist/mcp/test/*.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^3"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
