{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": "..",
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../src/v2/core/**/*.ts",
    "../src/v2/boundary/**/*.ts",
    "../src/v2/porkchop/grid-compute.ts",
    "../src/v2/porkchop/launch-vehicles.ts",
    "../src/v2/porkchop/delta-v.ts"
  ]
}
