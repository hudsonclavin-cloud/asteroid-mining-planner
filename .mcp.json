{
  "mcpServers": {
    "tooluniverse": {
      "command": "uvx",
      "args": ["tooluniverse@1.5.10"]
    },
    "aerospace": {
      "command": "uvx",
      "args": ["aerospace-mcp@0.1.0"]
    },
    "nasa-mcp": {
      "command": "npx",
      "args": ["-y", "@programcomputer/nasa-mcp-server@1.3.1"],
      "env": {
        "NASA_API_KEY": "${NASA_API_KEY:-DEMO_KEY}"
      }
    }
  }
}
